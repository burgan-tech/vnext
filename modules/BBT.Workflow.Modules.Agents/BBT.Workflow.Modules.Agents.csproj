<Project Sdk="Microsoft.NET.Sdk">
    <Import Project="..\..\common.props" />
    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <WarningsAsErrors>Nullable</WarningsAsErrors>
        <AssemblyName>BBT.Workflow.Agents</AssemblyName>
        <RootNamespace>BBT.Workflow.Agents</RootNamespace>
        <!-- MAF and the MCP SDK mark some members experimental. -->
        <NoWarn>$(NoWarn);MEAI001;MAAI001;MCPEXP001;OPENAI001</NoWarn>
    </PropertyGroup>

    <!--
      AI agent runtime (issue #1105). Referenced ONLY by the orchestration host: the Execution host must
      not carry Microsoft.Agents.AI, OpenAI or the MCP SDK (verify with
      `dotnet list execution/... package -include-transitive`).
    -->
    <ItemGroup>
        <PackageReference Include="Microsoft.Agents.AI" Version="1.27.0" />
        <PackageReference Include="Microsoft.Extensions.AI" Version="10.11.0" />
        <PackageReference Include="Microsoft.Extensions.AI.OpenAI" Version="10.11.0" />
        <PackageReference Include="OpenAI" Version="2.15.0" />
        <PackageReference Include="ModelContextProtocol.Core" Version="2.3.1" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\BBT.Workflow.Application\BBT.Workflow.Application.csproj" />
    </ItemGroup>

    <ItemGroup>
        <InternalsVisibleTo Include="BBT.Workflow.Application.Tests" />
    </ItemGroup>
</Project>
