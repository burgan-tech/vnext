{
  "ApplicationName": "vnext-execution",
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "OrchestrationApi": {
    "AppId": "vnext-app"
  },
  "Scripting": {
    "Helpers": {
      "Enabled": false
    },
    "SecretCache": {
      "Enabled": true,
      "TtlSeconds": 30
    },
    "Sandbox": {
      "Enabled": false,
      "AllowUnsafe": false,
      "PluginDirectory": "/app/assemblies",
      "AllowedAssemblies": [
        "System.Private.CoreLib",
        "System.Runtime",
        "System.Collections",
        "System.Linq",
        "System.Linq.Expressions",
        "System.Text.RegularExpressions",
        "Microsoft.CSharp",
        "netstandard"
      ],
      "BannedNamespaces": []
    }
  },
  "TriggerRetry": {
    "MaxRetryAttempts": 3,
    "RetryDelayMilliseconds": 2000,
    "RetryOnStatusCodes": [409],
    "UseJitter": true
  },
  "ResponseCompression": {
    "Enable": true,
    "Providers": ["gzip"],
    "EnableForHttps": true,
    "MimeTypes": [],
    "ExcludedMimeTypes": []
  },
  "Redis": {
    "Mode": "Standalone",
    "InstanceName": "workflow-api",
    "ConnectionTimeout": 5000,
    "DefaultDatabase": 0,
    "Password": "",
    "Ssl": false,
    "Standalone": {
      "EndPoints": ["localhost:6379"]
    },
    "RetryPolicy": {
      "MaxRetries": 3,
      "RetryTimeout": 1000
    }
  },
  "Telemetry": {
    "ServiceName": "vnext-execution-app",
    "ServiceNamespace": "BBT.Workflow.Execution",
    "ServiceVersion": "1.0.0",
    "TracingEnabled": true,
    "MetricsEnabled": true,
    "LoggingEnabled": true,
    "Otlp": {
      "Endpoint": "http://localhost:4318",
      "Protocol": "http/protobuf"
    },
    "Tracing": {
      "EnableConsoleExporter": false,
      "EnableOtlpExporter": true,
      "DetailLevel": "Business",
      "ExcludedPaths": ["^/health$", "^/metrics$", "^/live$", "^/ready$", "^/swagger/*"],
      "AdditionalSources": ["BBT.Workflow.Execution*", "BBT.Workflow.Cache", "BBT.Workflow.Pipeline"],
      "Headers": ["sub", "act_sub", "jti", "role", "X-Parent-Instance-Id", "User-Agent"]
    },
    "Metrics": {
      "EnableConsoleExporter": false,
      "EnableOtlpExporter": true,
      "AdditionalMeters": []
    },
    "Logging": {
      "EnableConsoleExporter": true,
      "EnableOtlpExporter": true,
      "IncludeFormattedMessage": true,
      "IncludeScopes": true,
      "ParseStateValues": true,
      "ExcludedPaths": ["^/health$", "^/metrics$", "^/live$", "^/ready$", "^/swagger/*"],
      "Enrichers": {
        "RequestHeaderKeyPrefix": "",
        "Headers": ["sub", "act_sub", "jti", "role", "X-Parent-Instance-Id", "User-Agent"],
        "CustomAttributes": {

        }
      },
      "Body": {
        "EnableRequestBody": false,
        "EnableResponseBody": false,
        "MaxBodyLengthToCapture": 16384,
        "AdditionalSensitiveJsonFields": [],
        "AdditionalSensitiveHeaderNames": []
      }
    }
  },
  "Kestrel": {
    "Limits": {
      "MaxRequestHeadersTotalSize": 65536,
      "MaxRequestHeaderCount": 200,
      "MaxRequestBodySize": 10485760
    }
  },
  "AllowedHosts": "*",
  "Vault": {
    "Enabled": false
  }
}
