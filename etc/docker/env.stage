# VNext Core Runtime Environment Variables - Staging
# Staging environment specific values

# VNext App URL - staging environment
# Use host.docker.internal to access host machine from Docker container
# Use vnext-app:4201 when running with docker-compose
VNEXT_APP_URL=http://host.docker.internal:4201

# Application domain for staging
APP_DOMAIN=stage

# VNext Core Runtime package version for staging
VNEXT_CORE_RUNTIME_VERSION=latest
