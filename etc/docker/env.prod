# VNext Core Runtime Environment Variables - Production
# Production environment specific values

# VNext App URL - production environment
# Use host.docker.internal to access host machine from Docker container
# Use vnext-app:4201 when running with docker-compose
VNEXT_APP_URL=http://host.docker.internal:4201

# Application domain for production
APP_DOMAIN=prod

# VNext Core Runtime package version for production
VNEXT_CORE_RUNTIME_VERSION=latest
