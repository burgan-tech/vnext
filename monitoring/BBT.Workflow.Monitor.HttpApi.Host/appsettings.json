{
    "ApplicationName": "vnext-monitor",
    "ConnectionStrings": {
        "Default": "Host=localhost;Port=5432;Database=Aether_WorkflowDb;Username=postgres;Password=postgres;"
    },
    "Logging": {
        "LogLevel": {
            "Default": "Information",
            "Microsoft.AspNetCore": "Warning",
            "System.Net.Http.HttpClient.OtlpTraceExporter.LogicalHandler": "Warning",
            "Microsoft.AspNetCore.Routing.EndpointMiddleware": "Warning",
            "System.Net.Http.HttpClient.Default.LogicalHandler": "Warning",
            "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
        }
    },
    "ResponseCompression": {
        "Enable": true,
        "Providers": ["gzip"],
        "EnableForHttps": true,
        "MimeTypes": [],
        "ExcludedMimeTypes": []
    },
    "Redis": {
        "Mode": "Standalone",
        "InstanceName": "workflow-monitor",
        "ConnectionTimeout": 5000,
        "DefaultDatabase": 0,
        "Password": "",
        "Ssl": false,
        "Standalone": {
            "EndPoints": ["localhost:6379"]
        },
        "RetryPolicy": {
            "MaxRetries": 3,
            "RetryTimeout": 1000
        }
    },
    "UrlTemplates": {
        "BasePath": "/api/v1/monitor"
    },
    "Telemetry": {
        "ServiceName": "vnext-monitor",
        "ServiceNamespace": "core",
        "ServiceVersion": "1.0.0",
        "TracingEnabled": true,
        "MetricsEnabled": true,
        "LoggingEnabled": true,
        "Tracing": {
            "EnableConsoleExporter": true,
            "EnableOtlpExporter": true,
            "ExcludedPaths": [
                "^/health$",
                "^/metrics$",
                "^/live$",
                "^/ready$",
                "^/swagger/*"
            ],
            "AdditionalSources": [],
            "Headers": ["sub", "act_sub", "jti", "role"]
        },
        "Metrics": {
            "EnableConsoleExporter": true,
            "EnableOtlpExporter": true,
            "AdditionalMeters": []
        },
        "Logging": {
            "EnableConsoleExporter": true,
            "EnableOtlpExporter": true,
            "IncludeFormattedMessage": true,
            "IncludeScopes": true,
            "ParseStateValues": true,
            "ExcludedPaths": [
                "^/health$",
                "^/metrics$",
                "^/live$",
                "^/ready$",
                "^/swagger/*"
            ],
            "Enrichers": {
                "Headers": ["sub", "act_sub", "jti", "role"],
                "CustomAttributes": {}
            },
            "Body": {
                "EnableRequestBody": false,
                "EnableResponseBody": false,
                "MaxBodyLengthToCapture": 16384,
                "AdditionalSensitiveJsonFields": [],
                "AdditionalSensitiveHeaderNames": []
            }
        }
    },
    "AllowedHosts": "*",
    "Vault": {
        "Enabled": false
    }
}
