<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <!-- Default NuGet.org source -->
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
    <!--
      Repo-local feed for unreleased BBT.Aether.* work, produced by aether's
      build/pack-local.sh. Only ever carries `-local` suffixed versions, so it cannot
      shadow a published release: a plain `1.0.38` still resolves from nuget.org.

      Pointing at a sibling checkout is deliberate — the path is relative to this file,
      so it works for anyone whose repos sit side by side, and it breaks loudly (rather
      than silently falling back to nuget.org) for anyone whose layout differs.

      To go back to released packages, set AetherPackageVersion in Directory.Build.props
      to a published version; this source then goes unused and can stay.
    -->
<!--    <add key="aether-local" value="../aether/.local-feed" />-->
  </packageSources>
  <packageSourceMapping>
    <!--
      Without mapping, NuGet queries every source for every package and takes the best
      match. That is slow, and it makes the local feed a possible answer for packages it
      has no business serving. Scoping it to BBT.Aether.* keeps the blast radius of a
      stray .nupkg in .local-feed to the framework itself.
    -->
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
<!--    <packageSource key="aether-local">-->
<!--      <package pattern="BBT.Aether.*" />-->
<!--    </packageSource>-->
  </packageSourceMapping>
</configuration>
