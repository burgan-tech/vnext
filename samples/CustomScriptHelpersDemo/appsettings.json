{
  "Scripting": {
    "Helpers": {
      "Enabled": true
    },
    "Sandbox": {
      "AllowUnsafe": false,
      "PluginDirectory": "plugins",
      "AllowedAssemblies": [
        "System.Private.CoreLib",
        "System.Runtime",
        "System.Runtime.Extensions",
        "System.Collections",
        "System.Collections.Concurrent",
        "System.Linq",
        "System.Linq.Expressions",
        "System.ObjectModel",
        "System.Text.RegularExpressions",
        "System.Console",
        "netstandard",
        "Newtonsoft.Json"
      ],
      "BannedNamespaces": [
        "System.IO",
        "System.Net",
        "System.Diagnostics",
        "System.Reflection",
        "System.Runtime.InteropServices",
        "Microsoft.Win32"
      ]
    },
    "ScriptServices": {
      "currency": "EUR"
    }
  }
}
