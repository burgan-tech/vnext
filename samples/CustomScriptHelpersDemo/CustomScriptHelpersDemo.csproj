<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Standalone demo — intentionally does NOT import ../../common.props so it
    stays decoupled from the main runtime build. Add it to your IDE manually;
    it is not part of any .sln.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>CustomScriptHelpersDemo</RootNamespace>
    <AssemblyName>CustomScriptHelpersDemo</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.0" />
    <!-- NOTE: no third-party NuGet here on purpose. Third-party DLLs are supplied at
         RUNTIME from the plugin directory (a Docker `volumes:` mount), never built in. -->
  </ItemGroup>

  <ItemGroup>
    <Content Include="appsettings.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Any DLLs a developer drops into ./plugins are copied next to the binary for local
       runs. In Docker this folder is replaced by a mounted volume (see docker-compose.yml);
       the host never references these assemblies — they are loaded dynamically. -->
  <ItemGroup>
    <Content Include="plugins\**\*.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The component store (helper/mapping .csx + flow .json) is compiled AT RUNTIME,
       not part of the host assembly. .csx is not picked up by the default *.cs glob,
       so we only need to copy it next to the binary (mimics the vNext component store). -->
  <ItemGroup>
    <Content Include="components\**\*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
