<Project Sdk="Microsoft.NET.Sdk.Web">

  <Import Project="..\..\common.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BBT.Workflow.Mcp</RootNamespace>
    <AssemblyName>BBT.Workflow.Mcp.Server</AssemblyName>
    <!-- This is a thin, decoupled host: it must NOT reference Application/Domain/Infrastructure. -->
  </PropertyGroup>

  <!-- dotnet tool packaging: `dotnet tool install -g BBT.Workflow.Mcp` exposes the `vnext-mcp` command (stdio). -->
  <PropertyGroup>
    <IsPackable>true</IsPackable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>vnext-mcp</ToolCommandName>
    <PackageId>BBT.Workflow.Mcp</PackageId>
    <Title>vNext Runtime MCP Server</Title>
    <Description>Model Context Protocol server for the vNext workflow runtime — discover components, query live instances, and read vnext-meta. Runs over stdio (local IDE) or Streamable HTTP.</Description>
    <Authors>Burgan Tech</Authors>
    <Company>Burgan Tech</Company>
    <PackageTags>mcp;model-context-protocol;vnext;workflow;ai</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryUrl>https://github.com/burgan-tech/vnext</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/burgan-tech/vnext</PackageProjectUrl>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" Version="1.4.0" />
    <PackageReference Include="ModelContextProtocol.AspNetCore" Version="1.4.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

</Project>
